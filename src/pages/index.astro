---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';

const posts = await getCollection('posts');
const sortedPosts = posts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

function getPostUrl(post: typeof posts[0]) {
  const rawPath = post.filePath || post.id;
  const baseName = rawPath.split('/').pop()?.replace(/\.md$/, '') || post.id;
  const match = baseName.match(/^(\d{4})-(\d{2})-(\d{2})-(.+)$/);
  const year = match ? match[1] : String(post.data.date.getFullYear());
  const month = match ? match[2] : String(post.data.date.getMonth() + 1).padStart(2, '0');
  const day = match ? match[3] : String(post.data.date.getDate()).padStart(2, '0');
  const slug = match ? match[4] : baseName;
  const category = Array.isArray(post.data.categories)
    ? post.data.categories[0]
    : (post.data.categories || 'post');

  return `/${category}/${year}/${month}/${day}/${slug}.html`;
}

function formatDate(date: Date) {
  return new Intl.DateTimeFormat('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  }).format(date);
}
---

<BaseLayout>
  <div class="space-y-10">
    <section class="border-b border-slate-200 pb-8">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
        Subhendu's Blog
      </h1>
      <p class="mt-3 text-lg text-slate-600 leading-relaxed">
        I plan to document things in this blog for the benefit of future me.
      </p>
    </section>

    <section>
      <h2 class="text-xl font-bold text-slate-900 mb-6 tracking-tight flex items-center gap-2">
        <span>Posts</span>
        <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600 border border-slate-200">
          {sortedPosts.length}
        </span>
      </h2>

      <div class="divide-y divide-slate-100">
        {sortedPosts.map((post) => {
          const url = getPostUrl(post);
          const categories = Array.isArray(post.data.categories)
            ? post.data.categories
            : [post.data.categories || 'post'];

          return (
            <article class="py-6 first:pt-0 last:pb-0 group">
              <div class="flex flex-col sm:flex-row sm:items-baseline sm:justify-between gap-1 mb-2">
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-sky-600 transition-colors">
                  <a href={url}>{post.data.title}</a>
                </h3>
                <time
                  datetime={post.data.date.toISOString()}
                  class="text-sm font-medium text-slate-400 whitespace-nowrap"
                >
                  {formatDate(post.data.date)}
                </time>
              </div>

              {post.data.description && (
                <p class="text-sm text-slate-600 line-clamp-2 mt-1 mb-3">
                  {post.data.description}
                </p>
              )}

              <div class="flex items-center gap-2 mt-2">
                {categories.map((cat) => (
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-slate-100 text-slate-600 border border-slate-200 uppercase tracking-wide">
                    {cat}
                  </span>
                ))}
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </div>
</BaseLayout>
