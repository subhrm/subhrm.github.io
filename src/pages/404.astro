---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Page Not Found">
  <div class="py-16 text-center">
    <span class="text-6xl sm:text-7xl font-extrabold text-sky-600 tracking-tight block mb-4">
      404
    </span>
    <h1 class="text-2xl sm:text-3xl font-bold text-slate-900 mb-3">
      Page not found
    </h1>
    <p class="text-slate-600 mb-8 max-w-md mx-auto">
      Sorry, we couldn't find the page you're looking for. It might have been moved or deleted.
    </p>
    <a
      href="/"
      class="inline-flex items-center justify-center px-5 py-2.5 rounded-lg bg-sky-600 text-white font-medium hover:bg-sky-700 transition-colors shadow-sm"
    >
      Return Home
    </a>
  </div>
</BaseLayout>
