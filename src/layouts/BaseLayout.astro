---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  article?: boolean;
}

const {
  title = "Subhendu's Blog",
  description = "I plan to document things in this blog for the benefit of future me.",
  image = "/favicon.ico",
  article = false,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const siteTitle = title === "Subhendu's Blog" ? title : `${title} | Subhendu's Blog`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <!-- Theme & Layout Initialization Script (Anti-FOUC) -->
    <script is:inline>
      (function() {
        const storedTheme = typeof localStorage !== 'undefined' ? localStorage.getItem('theme') : null;
        if (storedTheme === 'dark' || (!storedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        const storedWidth = typeof localStorage !== 'undefined' ? localStorage.getItem('layout-width') : null;
        if (storedWidth === 'narrow') {
          document.documentElement.classList.add('narrow-layout');
        } else {
          document.documentElement.classList.remove('narrow-layout');
        }
      })();
    </script>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonicalURL} />

    <!-- Primary Meta Tags -->
    <title>{siteTitle}</title>
    <meta name="title" content={siteTitle} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.site)} />
    <meta property="og:site_name" content="Subhendu's Blog" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={siteTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.site)} />
    <meta name="twitter:creator" content="@subhendu" />

    <!-- RSS Feed Link -->
    <link rel="alternate" type="application/rss+xml" title="Subhendu's Blog RSS Feed" href="/feed.xml" />

    <!-- MathJax for LaTeX formulas -->
    <script is:inline>
      window.MathJax = {
        tex: {
          inlineMath: [['$', '$'], ['\\(', '\\)']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']]
        },
        options: {
          skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre']
        }
      };
    </script>
    <script is:inline id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>

    <!-- Mermaid Diagrams -->
    <script is:inline src="https://cdn.jsdelivr.net/npm/mermaid@10/dist/mermaid.min.js"></script>
    <script is:inline>
      async function renderMermaidDiagrams() {
        const blocks = Array.from(document.querySelectorAll('pre[data-language="mermaid"], pre.mermaid, code.language-mermaid, pre:has(> code[data-language="mermaid"])'));
        if (blocks.length === 0) return;

        if (typeof mermaid === 'undefined') {
          console.error('Mermaid library not loaded');
          return;
        }

        const isDark = document.documentElement.classList.contains('dark');
        mermaid.initialize({
          startOnLoad: false,
          theme: isDark ? 'dark' : 'default',
          securityLevel: 'loose',
          fontFamily: 'inherit'
        });

        for (let i = 0; i < blocks.length; i++) {
          const el = blocks[i];
          const pre = el.tagName === 'PRE' ? el : el.closest('pre') || el;
          
          const lines = pre.querySelectorAll('.line');
          let codeText = '';
          if (lines.length > 0) {
            codeText = Array.from(lines).map(l => l.textContent).join('\n').trim();
          } else {
            codeText = (pre.textContent || '').trim();
          }

          if (!codeText) continue;

          try {
            const id = `mermaid-svg-${i}-${Math.random().toString(36).substring(2, 9)}`;
            const { svg } = await mermaid.render(id, codeText);
            const wrapper = document.createElement('div');
            wrapper.className = 'mermaid';
            wrapper.innerHTML = svg;
            if (pre.parentNode) {
              pre.parentNode.replaceChild(wrapper, pre);
            }
          } catch (err) {
            console.error('Mermaid render error for diagram ' + i, err);
          }
        }
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', renderMermaidDiagrams);
      } else {
        renderMermaidDiagrams();
      }
    </script>
  </head>
  <body class="flex flex-col min-h-screen text-slate-900 dark:text-slate-100 bg-slate-50 dark:bg-[#090d16]">
    <Header />
    <main class="site-container flex-1 px-4 sm:px-6 py-8 sm:py-12">
      <div class="bg-white/95 dark:bg-slate-900/90 backdrop-blur-md rounded-2xl shadow-xl shadow-slate-900/5 dark:shadow-black/40 border border-slate-200/80 dark:border-slate-800 p-6 sm:p-10 md:p-12 transition-colors duration-200">
        <slot />
      </div>
    </main>
    <Footer />
  </body>
</html>
